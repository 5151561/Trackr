<?xml version="1.0" encoding="utf-8"?>
<!--
  明文 http 白名单（第 29 步，替换原来的 android:usesCleartextTraffic="true"）。

  本工程自己的接口全是 https：车来了 web.chelaile.net.cn、掌上公交 h5.mygolbs.com、高德 Web 服务
  restapi.amap.com、城市列表 cdn/fastly.jsdelivr.net 与 raw.githubusercontent.com、版本检查
  github.com（GithubUpdateChecker 只认 https:// 开头）。

  只有高德 SDK（3dmap-location-search 11.3.100）里还写着 http 地址：地图渲染 render*.amap.com、
  路线搜索 restsdk.amap.com（ServiceSettings 默认 HTTP）、定位 apilocate.amap.com / aps.amap.com、
  tsapi / mpsapi.amap.com，以及定位用的星历 gnss-eph.oss-cn-hangzhou.aliyuncs.com。
  所以只对这几处放开明文，其余一律 https。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">amap.com</domain>
        <domain includeSubdomains="true">autonavi.com</domain>
        <domain includeSubdomains="false">gnss-eph.oss-cn-hangzhou.aliyuncs.com</domain>
        <!-- 掌上出行（朗斯）城市清单是明文 HTTP；代码里还走了一层原始 socket 兜底 -->
        <domain includeSubdomains="true">222.76.217.238</domain>
    </domain-config>
</network-security-config>
