<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 云备份与设备迁移规则：只排除存放自定义高德 Key 的 trackr_amap_keys.xml，其余设置照常备份 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="trackr_amap_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="trackr_amap_keys.xml" />
    </device-transfer>
</data-extraction-rules>
