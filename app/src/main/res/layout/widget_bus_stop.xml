<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:padding="14dp">

    <!-- 空状态视图：未添加任何收藏时展示 -->
    <LinearLayout
        android:id="@+id/widget_empty_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="车在路上 · 实时候车卡"
            android:textColor="#1D1B20"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="暂无收藏的候车站，点击打开 App 添加"
            android:textColor="#79747E"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 正常实时到站内容卡片 -->
    <LinearLayout
        android:id="@+id/widget_content_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- 顶部信息行：线路名徽标、城市/数据源标签、更新时间、刷新按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_line_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1路"
                android:textColor="#1D1B20"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_city_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="上海 · 车来了"
                android:textColor="#49454F"
                android:textSize="11sp" />

            <!-- RemoteViews 中必须使用 FrameLayout 等合法标签作为弹簧占位，不能直接使用 View -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_updated_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="刚刚更新"
                android:textColor="#79747E"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_btn_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="🔄"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 方向与候车站 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_direction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="开往 人民广场"
                android:textColor="#49454F"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" · "
                android:textColor="#79747E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_stop_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="候车站: 南京东路"
                android:textColor="#006688"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 倒计时大字 -->
        <TextView
            android:id="@+id/widget_eta_large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="还有 2 站 · 约 4 分钟"
            android:textColor="#006688"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 实时到站进度条 -->
        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:indeterminate="false"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="50" />

    </LinearLayout>

</FrameLayout>
